#!/usr/bin/env bash
# ======================================================================
#  qwen-avatar  –  Cambio y ajuste automático de avatar para el widget
#
#  Uso:
#    qwen-avatar <ruta-a-imagen>    (recorta al centro 1:1 y redimensiona)
#    qwen-avatar --reset            (restablece avatar original)
# ======================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WIDGET_DIR="${QWEN_WIDGET_DIR:-$SCRIPT_DIR}"
if [ ! -f "${WIDGET_DIR}/lib/main.lua" ]; then
    WIDGET_DIR="/opt/qwen-widget"
fi

export LUA_PATH="/usr/share/lua/5.3/?.lua;/usr/share/lua/5.3/?/init.lua;${WIDGET_DIR}/lib/?.lua;${WIDGET_DIR}/?.lua;;"
export LUA_CPATH="${WIDGET_DIR}/lib/?.so;/usr/lib/x86_64-linux-gnu/lua/5.3/?.so;/usr/lib/x86_64-linux-gnu/lua/5.3/?/corelgilua51.so;/usr/lib/lua/5.3/?.so;;"

LUA_BIN=""
for candidate in "${WIDGET_DIR}/bin/lua5.3" "/opt/qwen-widget/bin/lua5.3" "$HOME/.local/bin/lua5.3" /usr/bin/lua5.3 /usr/local/bin/lua5.3; do
    if [ -x "$candidate" ]; then
        LUA_BIN="$candidate"
        break
    fi
done

if [ -z "$LUA_BIN" ]; then
    echo "[qwen-avatar] ERROR: lua5.3 no encontrado." >&2
    exit 1
fi

exec "$LUA_BIN" "${WIDGET_DIR}/lib/avatar_customizer.lua" "$@"
