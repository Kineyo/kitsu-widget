# Maintainer: Kitsu Team <dev@kitsu.local>
pkgname=kitsu
pkgver=2.0.0
pkgrel=1
pkgdesc="Kitsu - Hybrid Desktop AI Companion & Media Suite (< 500 MB RAM), YT Music/Spotify synced lyrics, instant grammar checker"
arch=('x86_64')
url="https://github.com/Kineyo/widget-lua"
license=('MIT')
depends=('lua53' 'gtk3' 'glib2' 'libx11' 'libxfixes' 'libxi' 'curl')
optdepends=('lua-lgi: for GTK GUI widgets' 'lua53-lgi: for Lua 5.3 LGI bindings')
makedepends=('cmake' 'gcc' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "${startdir}/../.."
  cmake -S . -B build-arch -DCMAKE_BUILD_TYPE=Release
  cmake --build build-arch -j"$(nproc)"
}

package() {
  cd "${startdir}/../.."
  install -dm755 "${pkgdir}/opt/kitsu/bin"
  install -dm755 "${pkgdir}/opt/kitsu/lib/native"
  install -dm755 "${pkgdir}/opt/kitsu/lib/skills"
  install -dm755 "${pkgdir}/opt/kitsu/assets/sprites"
  install -dm755 "${pkgdir}/opt/kitsu/assets/icons"
  install -dm755 "${pkgdir}/opt/kitsu/models"
  install -dm755 "${pkgdir}/usr/bin"
  install -dm755 "${pkgdir}/usr/share/applications"

  for b in kitsu kitsu-power kitsu-avatar kitsu-bin qwen-widget qwen-power qwen-avatar qwen-widget-bin llama-server; do
    [ -f "bin/${b}" ] && install -m755 "bin/${b}" "${pkgdir}/opt/kitsu/bin/${b}"
  done

  cp -a lib/*.lua "${pkgdir}/opt/kitsu/lib/"
  cp -a lib/*.so "${pkgdir}/opt/kitsu/lib/" 2>/dev/null || true
  cp -a lib/skills/*.lua "${pkgdir}/opt/kitsu/lib/skills/"
  cp -a lib/native/* "${pkgdir}/opt/kitsu/lib/native/" 2>/dev/null || true
  cp -a assets/* "${pkgdir}/opt/kitsu/assets/"

  ln -sf /opt/kitsu/bin/kitsu "${pkgdir}/usr/bin/kitsu"
  ln -sf /opt/kitsu/bin/kitsu-power "${pkgdir}/usr/bin/kitsu-power"
  ln -sf /opt/kitsu/bin/kitsu-avatar "${pkgdir}/usr/bin/kitsu-avatar"
  ln -sf /opt/kitsu/bin/kitsu "${pkgdir}/usr/bin/qwen-widget"

  cat > "${pkgdir}/usr/share/applications/kitsu.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Kitsu
GenericName=Desktop AI Companion
Comment=Hybrid Desktop AI Companion with llama.cpp and synced lyrics
Exec=/opt/kitsu/bin/kitsu
Icon=/opt/kitsu/assets/icon.png
Terminal=false
Categories=Utility;Office;AudioVideo;
EOF
}
